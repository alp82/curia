[Unit]
Description=curia daemon
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=alp
WorkingDirectory=/home/alp/curia/daemon
EnvironmentFile=/home/alp/curia/daemon/.env
Environment=PATH=/home/alp/.local/bin:/usr/local/bin:/usr/bin:/bin
# node directly, not `npm start`: KillMode=process kills only the MAIN pid,
# so the main pid must BE the daemon — killing npm alone would orphan node
# and leave two daemons fighting over the port and the Discord token.
ExecStart=/usr/local/bin/node src/index.mjs
Restart=on-failure
RestartSec=5
# Agents live in a tmux server the daemon spawns, INSIDE this service's
# cgroup. The default (control-group) kill reaped that server on every
# restart — a deploy at 10:54 on 2026-08-02 killed a live agent mid-ticket
# (wayfinder #132). `process` kills only the daemon; tmux and its agents
# survive the restart, and boot reconcile re-adopts them.
KillMode=process

[Install]
WantedBy=multi-user.target
